# ── DATABASE ────────────────────────────────────────
DATABASE_URL=postgresql://nexmart:localpassword@localhost:5432/nexmart_dev
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# ── AUTH / JWT ──────────────────────────────────────
JWT_SECRET=nexmart-jwt-secret-change-in-production
JWT_REFRESH_SECRET=nexmart-jwt-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── GOOGLE OAUTH ────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── RAZORPAY ────────────────────────────────────────
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ── STRIPE (Backup Gateway) ────────────────────────
STRIPE_SECRET_KEY=your-stripe-secret-key

# ── TWILIO (SMS / OTP) ─────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE=+1234567890

# ── AWS ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nexmart-assets

# ── SHIPROCKET ──────────────────────────────────────
SHIPROCKET_EMAIL=your-shiprocket-email
SHIPROCKET_PASSWORD=your-shiprocket-password

# ── GOOGLE MAPS ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ── CLIENT-SIDE (Next.js public) ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SERVICES (Internal ports) ──────────────────────
AUTH_SERVICE_PORT=4001
PRODUCT_SERVICE_PORT=4002
ORDER_SERVICE_PORT=4003
PAYMENT_SERVICE_PORT=4004
VENDOR_SERVICE_PORT=4005
SEARCH_SERVICE_PORT=4006
LOGISTICS_SERVICE_PORT=4007
NOTIFICATION_SERVICE_PORT=4008
RECOMMENDATION_SERVICE_PORT=4009
ANALYTICS_SERVICE_PORT=4010

# ── MONITORING ──────────────────────────────────────
SENTRY_DSN=your-sentry-dsn
MIXPANEL_TOKEN=your-mixpanel-token
